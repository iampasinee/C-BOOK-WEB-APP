<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - C-BOOK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('./partials/header.ejs') %>

    <main class="container" style="padding-top: 40px; padding-bottom: 60px;">
        <div class="checkout-header">
            <h2>Secure Checkout</h2>
            <p>Please enter your details below to complete your purchase.</p>
        </div>

        <form action="/checkout/process" method="POST" class="checkout-grid">
            
            <div class="checkout-form-section">
                <div class="checkout-card">
                    <h3><i class="fa-solid fa-location-dot"></i> Shipping Information</h3>
                    
                    <div class="form-row">
                        <div class="form-group half">
                            <label>Full Name</label>
                            <input type="text" name="fullName" required placeholder="John Doe" value="<%= userName %>">
                        </div>
                        <div class="form-group half">
                            <label>Phone Number</label>
                            <input type="tel" name="phone" maxlength="10" required placeholder="08x-xxx-xxxx">
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Shipping Address</label>
                        <textarea name="address" required rows="3" placeholder="..."></textarea>
                    </div>
                </div>

                <div class="checkout-card" style="margin-top: 20px;">
                    <h3><i class="fa-solid fa-credit-card"></i> Payment Method</h3>
                    <div class="payment-methods">
                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="cod" checked>
                            <div class="payment-box">
                                <i class="fa-solid fa-money-bill-wave"></i>
                                <span>Cash on Delivery</span>
                            </div>
                        </label>
                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="transfer">
                            <div class="payment-box">
                                <i class="fa-solid fa-building-columns"></i>
                                <span>Bank Transfer</span>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <div class="checkout-summary-section">
                <div class="checkout-card summary-card">
                    <h3>Order Summary</h3>
                    
                    <div class="summary-items">
                        <% cart.forEach(item => { %>
                            <div class="summary-item">
                                <div class="item-img-box">
                                    <img src="<%= backendBaseUrl %>/images/<%= item.img %>" alt="<%= item.title %>">
                                    </div>
                                <div class="item-details">
                                    <h4><%= item.title %></h4>
                                    <p>฿<%= parseFloat(item.price).toLocaleString('en-US', {minimumFractionDigits: 2}) %></p>
                                    <p class="item-qty-text">Qty: <b><%= item.quantity %></b></p>
                                </div>
                                <div class="item-total-price">
                                    ฿<%= parseFloat(item.price * item.quantity).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <div class="summary-totals">
                        <div class="total-line">
                            <span>Subtotal (<%= totalItems %> items)</span>
                            <span>฿<%= parseFloat(totalPrice).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                        </div>
                        <div class="total-line">
                            <span>Shipping Fee</span>
                            <span>฿<%= parseFloat(shippingFee).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                        </div>
                        <div class="total-line grand-total">
                            <span>Total Amount</span>
                            <span class="highlight-price">฿<%= parseFloat(grandTotal).toLocaleString('en-US', {minimumFractionDigits: 2}) %></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-place-order">
                        <i class="fa-solid fa-check-circle"></i> Place Order
                    </button>
                </div>
            </div>

        </form>
    </main>
</body>
</html>
