<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>C-BOOK Store</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('./partials/header.ejs') %>

        <main class="container">

            <div class="store-header">
                <h2>Recommended Books</h2>
                <p>Discover your next favorite book from our top selections.</p>
            </div>

            <div class="book-grid">
                <% if (books.length===0) { %>
                    <div class="no-books">
                        <i class="fa-solid fa-book-open"
                            style="font-size: 40px; color: #ddd; margin-bottom: 15px; display: block;"></i>
                        No books available at the moment.
                    </div>
                <% } else { %>
                    <% books.forEach(book=> { %>
                        <div class="book-card">
                            <div class="book-img-wrapper">
                                <img src="<%= backendBaseUrl %>/images/<%= book.book_img || 'default_book.png' %>"
                                    alt="<%= book.title %>" class="book-img">
                                <span class="category-badge">
                                    <%= book.category ? book.category.category_name : 'Uncategorized' %>
                                </span>
                            </div>

                            <div class="book-info">
                                <h3 class="book-title">
                                    <%= book.title %>
                                </h3>
                                <p class="book-author">
                                    <%= book.author %>
                                </p>
                                <div class="book-price">฿<%= parseFloat(book.price).toLocaleString('en-US', {
                                        minimumFractionDigits: 2 }) %>
                                </div>

                                <% if (userLoggedIn) { %>
                                    <button class="btn-action btn-add-cart"
                                        onclick="addToCart('<%= book.book_id %>')">
                                        <i class="fa-solid fa-cart-plus"></i> Add to Cart
                                    </button>
                                <% } else { %>
                                    <a href="/login" class="btn-action btn-must-login">
                                        <i class="fa-solid fa-lock"></i> Login to Buy
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
            
            <% if (totalPages > 1) { %>
                <div class="store-pagination" id="paginationContainer">
                    <a href="<%= currentPage > 1 ? '?page=' + (currentPage - 1) + '&search=' + (typeof searchQuery !== 'undefined' ? searchQuery : '') : '#' %>"
                        class="page-link <%= currentPage === 1 ? 'disabled' : '' %>">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>

                    <% for (let i=1; i <=totalPages; i++) { 
                        if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                            <a href="?page=<%= i %>&search=<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" 
                               class="page-link <%= currentPage === i ? 'active' : '' %>">
                                <%= i %>
                            </a>
                        <% } else if (i === currentPage - 2 || i === currentPage + 2) { %>
                            <span class="page-dots">...</span>
                        <% } 
                    } %>

                    <a href="<%= currentPage < totalPages ? '?page=' + (currentPage + 1) + '&search=' + (typeof searchQuery !== 'undefined' ? searchQuery : '') : '#' %>"
                        class="page-link <%= currentPage === totalPages ? 'disabled' : '' %>">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </div>
            <% } %>

            <div class="cart-overlay" id="cartOverlay"></div>
    <div class="cart-sidebar" id="cartSidebar">
        <div class="cart-sidebar-header">
            <h3><i class="fa-solid fa-cart-shopping"></i> Your Cart</h3>
            <button id="closeCartBtn" class="close-cart-btn"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="cart-sidebar-body" id="cartItemsContainer">
            <div style="text-align:center; padding: 40px 20px; color: #888;">
                <i class="fa-solid fa-basket-shopping" style="font-size: 40px; color: #ddd; margin-bottom: 10px;"></i>
                <p>Your cart is empty.</p>
            </div>
        </div>

        <div class="cart-sidebar-footer">
            <div class="cart-total">
                <span>Total:</span>
                <span id="cartTotalPrice"
                    style="color: var(--primary-red); font-weight: 700; font-size: 20px;">฿0.00</span>
            </div>
            <a href="/checkout" class="auth-btn"
                style="text-align: center; text-decoration: none; display: block; margin-top: 15px;">
                Checkout
            </a>
        </div>
    </div>

        </main>

        <script>
            window.BACKEND_BASE_URL = '<%= backendBaseUrl %>';
        </script>
        <script src="/js/main.js"></script>
</body>

</html>

<script>
    // 1. ดักจับค่าจาก URL (Query String)
    const urlParams = new URLSearchParams(window.location.search);
    
    // 2. เช็กว่าค่า success เป็น true หรือไม่
    if (urlParams.get('success') === 'true') {
        // 3. แสดง Alert พื้นฐาน
        alert('สั่งซื้อสินค้าสำเร็จเรียบร้อยแล้ว!');

        // 4. ลบ ?success=true ออกจาก URL ทันทีเพื่อความสะอาด
        const cleanUrl = window.location.origin + window.location.pathname;
        window.history.replaceState({}, document.title, cleanUrl);
    }
</script>
