<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - C-BOOK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-manage.css">
</head>

<body>
    <%- include('../../partials/sidebar.ejs') %>
        <main class="content-area">
            <div class="form-card">
                <div class="form-header">
                    <h2>Add New Book</h2>
                </div>

                <div class="form-body">
                    <form action="/management/books/create" method="POST" enctype="multipart/form-data">

                        <div class="form-group">
                            <label class="form-label">Book Title</label>
                            <input type="text" name="title" class="form-input" required
                                placeholder="Enter book title...">
                        </div>

                        <div class="form-group">
                            <label class="form-label">Author</label>
                            <input type="text" name="author" class="form-input" required
                                placeholder="Enter author name...">
                        </div>

                        <div style="display: flex; gap: 20px;">
                            <div class="form-group" style="flex: 1;">
                                <label class="form-label">Price</label>
                                <input type="number" name="price" step="1" class="form-input" required
                                    placeholder="0.00">
                            </div>

                            <div class="form-group" style="flex: 1;">
                                <label class="form-label">Stock Quantity</label>
                                <input type="number" name="stock_quantity" class="form-input" value="1" min="0" required
                                    placeholder="1">
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Category</label>
                            <select name="category_id" class="form-input" required>
                                <option value="" disabled selected>-- Select a Category --</option>
                                <% categories.forEach(cat=> { %>
                                    <option value="<%= cat.category_id %>">
                                        <%= cat.category_name %>
                                    </option>
                                <% }) %>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Book Cover Image</label>
                            <input type="file" name="book_img" id="bookImageInput" class="form-input" accept="image/*">
                            
                            <div class="image-preview-container" id="previewContainer">
                                <img id="imagePreview" src="" alt="Image Preview">
                            </div>
                        </div>

                        <div class="form-actions">
                            <button type="submit" class="btn-submit">Save Book</button>
                            <a href="/management/books" class="btn-cancel">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

    <script>
        const imageInput = document.getElementById('bookImageInput');
        const previewContainer = document.getElementById('previewContainer');
        const imagePreview = document.getElementById('imagePreview');

        imageInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imagePreview.src = e.target.result;
                    previewContainer.style.display = 'block'; 
                }
                reader.readAsDataURL(file);
            } else {
                imagePreview.src = '';
                previewContainer.style.display = 'none';
            }
        });
    </script>
</body>

</html>