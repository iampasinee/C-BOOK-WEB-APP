<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sales by Category Report - C-BOOK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-manage.css">
    <link rel="stylesheet" href="/css/report.css">
</head>
<body>
    <div class="main-layout">
        <%- include('../../partials/sidebar.ejs') %>
        <main class="content-area">
            
            <div class="report-header-actions">
                <div>
                    <h1>Sales by Category</h1>
                    <p class="subtitle">Report showing total revenue and books sold grouped by category.</p>
                </div>
                <button class="btn-print" onclick="window.print()">
                    <i class="fa-solid fa-print"></i> Print Report
                </button>
            </div>

            <div class="filter-summary-card">
                <div class="toolbar-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" id="searchInput" onkeyup="filterReport()" placeholder="Search Category name...">
                </div>
                <div class="summary-stats-group">
                    <div class="stat-group-item">
                        <span class="stat-group-label">TOTAL CATEGORIES</span>
                        <span class="stat-group-value" id="displayTotalCat"><%= reportData.length %></span>
                    </div>
                    <div class="stat-divider"></div>
                    <div class="stat-group-item">
                        <span class="stat-group-label">TOTAL BOOKS</span>
                        <span class="stat-group-value" id="displayTotalBooks"><%= grandTotalQty.toLocaleString() %></span>
                    </div>
                </div>
            </div>

            <div class="report-card">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th class="th-rank">Rank</th>
                            <th>Category Name</th>
                            <th class="text-center th-qty">Books Sold (Qty)</th>
                            <th class="text-right th-revenue">Total Revenue</th>
                            <th class="text-center action-col" style="width: 100px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (reportData.length === 0) { %>
                            <tr><td colspan="5" class="empty-report-msg">No sales data available.</td></tr>
                        <% } else { %>
                            <% reportData.forEach((row, index) => { %>
                                <tr class="data-row">
                                    <td class="text-center">
                                        <span class="rank-badge <%= index === 0 ? 'rank-1' : index === 1 ? 'rank-2' : index === 2 ? 'rank-3' : '' %>"><%= index + 1 %></span>
                                    </td>
                                    <td class="td-category"><%= row.name %></td>
                                    <td class="text-center td-qty"><%= row.totalQty.toLocaleString() %> pcs</td>
                                    <td class="text-right td-revenue">฿<%= parseFloat(row.totalRevenue).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
                                    <td class="text-center">
                                        <a href="/management/reports/sales-by-category/<%= row.id %>" class="btn-view-details" style="color: var(--primary-blue); font-size: 13px; font-weight: 600; text-decoration: none; padding: 6px 12px; background: #eff6ff; border-radius: 6px;">View</a>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" class="tfoot-label">GRAND TOTAL</td>
                            <td class="text-center tfoot-qty" id="footerTotalQty"><%= grandTotalQty.toLocaleString() %> pcs</td>
                            <td class="text-right tfoot-value" id="footerTotalRevenue">฿<%= parseFloat(grandTotalRevenue).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </main>
    </div>

    <script>
        function filterReport() {
            const input = document.getElementById("searchInput").value.toUpperCase();
            const table = document.querySelector(".report-table");
            const rows = table.getElementsByTagName("tbody")[0].getElementsByClassName("data-row");

            let visibleQty = 0;
            let visibleRevenue = 0;
            let visibleCategories = 0;

            for (let i = 0; i < rows.length; i++) {
                const tdCategory = rows[i].getElementsByTagName("td")[1];
                const tdQty = rows[i].querySelector(".td-qty");
                const tdRevenue = rows[i].querySelector(".td-revenue");

                if (tdCategory) {
                    const txtValue = tdCategory.textContent || tdCategory.innerText;
                    
                    if (txtValue.toUpperCase().indexOf(input) > -1) {
                        rows[i].style.display = ""; // แสดงแถว
                        visibleCategories++;
                        
                        // แกะตัวเลขจากข้อความ เช่น "1,500 pcs" -> 1500
                        const qtyValue = parseInt(tdQty.innerText.replace(/,/g, '').replace(' pcs', '')) || 0;
                        // แกะตัวเลขจากข้อความ เช่น "฿1,500.00" -> 1500.00
                        const revenueValue = parseFloat(tdRevenue.innerText.replace(/฿/g, '').replace(/,/g, '')) || 0;

                        visibleQty += qtyValue;
                        visibleRevenue += revenueValue;

                    } else {
                        rows[i].style.display = "none"; // ซ่อนแถว
                    }
                }
            }

            // 🚨 อัปเดตยอด GRAND TOTAL ท้ายตาราง
            document.getElementById("footerTotalQty").innerText = visibleQty.toLocaleString() + " pcs";
            document.getElementById("footerTotalRevenue").innerText = "฿" + visibleRevenue.toLocaleString('en-US', {minimumFractionDigits: 2});

            // 🚨 อัปเดตยอดสรุปด้านบน (TOTAL CATEGORIES / TOTAL BOOKS)
            document.getElementById("displayTotalCat").innerText = visibleCategories;
            document.getElementById("displayTotalBooks").innerText = visibleQty.toLocaleString();
        }
    </script>
</body>
</html>