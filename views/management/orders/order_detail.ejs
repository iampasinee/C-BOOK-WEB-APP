<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details #ORD-<%= typeof order !== 'undefined' && order ? order.order_id.toString().padStart(4, '0') : 'Error' %> - C-BOOK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style-manage.css">
</head>
<body>
    <div class="main-layout">
        <%- include('../../partials/sidebar.ejs') %>
        <main class="content-area">
            
            <div style="margin-bottom: 15px;">
                <a href="/management/orders" class="btn-back">
                    <i class="fa-solid fa-arrow-left"></i> Back to Orders
                </a>
            </div>

            <div class="order-header-card">
                <div class="order-header-row">
                    <div>
                        <h1 style="margin: 0; font-size: 22px; color: #1e293b;">Order #ORD-<%= order.order_id.toString().padStart(4, '0') %></h1>
                        <div class="order-date-badges">
                            <span class="date-badge">Placed on: <%= new Date(order.order_date).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short' }) %></span>
                        </div>
                    </div>
                    <div class="header-right-action">
                        <div class="header-grand-total">
                            <%= parseFloat(grandTotal).toLocaleString('en-US', {minimumFractionDigits: 2}) %>
                        </div>
                        <span class="detail-status-badge badge-<%= order.status %>" id="headerStatusBadge">
                            <i class="fa-solid fa-circle status-dot"></i> <%= order.status %>
                        </span>
                    </div>
                    
                </div>
            </div>

            <div class="status-control-card">
                <div class="status-control-info">
                    <h3>Update Order Status</h3>
                    <p>Change the current status of this order to notify the customer.</p>
                </div>
                <div class="status-control-action">
                    <select class="status-dropdown status-<%= order.status %>" id="orderStatusSelect" onfocus="this.dataset.previous = this.value">
                        <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                        <option value="delivered" <%= order.status === 'delivered' ? 'selected' : '' %>>Delivered</option>
                        <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                    </select>
                    <button class="btn-update-status" onclick="updateStatus('<%= order.order_id %>')">Save Changes</button>
                </div>
            </div>

            <div class="customer-info-grid">
                <div class="info-card">
                    <div class="info-card-header">
                        <h3>CUSTOMER & ORDER</h3>
                    </div>
                    <div class="info-card-body">
                        <div class="info-row"><span class="label">Name</span><span class="value">: <%= order.user ? order.user.user_name : 'N/A' %></span></div>
                        <div class="info-row"><span class="label">Email</span><span class="value">: <%= order.user ? order.user.user_email : 'N/A' %></span></div>
                        <div class="info-row"><span class="label">Payment</span><span class="value">: Cash on Delivery</span></div>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-card-header">
                        <h3>SHIPPING ADDRESS</h3>
                    </div>
                    <div class="info-card-body">
                        <p style="color: #475569; line-height: 1.6;">
                            Standard Shipping<br>
                            Address details will be displayed here once integrated with the checkout form.
                        </p>
                    </div>
                </div>
            </div>

            <div class="items-ordered-section">
                <div class="items-section-header">
                    <h3>Items Ordered</h3>
                </div>
                
                <table class="items-table">
                    <thead>
                        <tr>
                            <th>ITEMS NAME</th>
                            <th style="text-align: center;">QUANTITY</th>
                            <th style="text-align: right;">PRICE</th>
                            <th style="text-align: right; padding-right: 25px;">TOTAL</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% order.orderDetails.forEach(item => { %>
                            <tr>
                                <td>
                                    <div class="item-product-cell">
                                        <img src="/images/<%= item.book ? item.book.book_img : 'default_book.png' %>" alt="Book Cover">
                                        <span class="item-title-text"><%= item.book ? item.book.title : 'Unknown Book' %></span>
                                    </div>
                                </td>
                                <td style="text-align: center; font-weight: 500; color: #475569;"><%= item.quantity %></td>
                                <td style="text-align: right; color: #475569;"><%= parseFloat(item.unit_price).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
                                <td style="text-align: right; font-weight: 600; color: #1e293b; padding-right: 25px;"><%= parseFloat(item.unit_price * item.quantity).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="2" class="tfoot-empty"></td>
                            <td class="tfoot-label">Subtotal</td>
                            <td class="tfoot-value"><%= parseFloat(itemsTotal).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
                        </tr>
                        <tr>
                            <td colspan="2" class="tfoot-empty border-top-row"></td>
                            <td class="tfoot-label grand-label border-top-row">Total Amount</td>
                            <td class="tfoot-value grand-value border-top-row"><%= parseFloat(grandTotal).toLocaleString('en-US', {minimumFractionDigits: 2}) %></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

        </main>
    </div>

    <script>
        function updateStatus(orderId) {
            const selectElement = document.getElementById('orderStatusSelect');
            const newStatus = selectElement.value;
            const previousStatus = selectElement.dataset.previous;
            const orderIdFormatted = String(orderId).padStart(4, '0');

            if (newStatus === previousStatus) {
                alert("Status is already set to " + newStatus.toUpperCase());
                return;
            }

            const confirmMsg = `Are you sure you want to update Order #ORD-${orderIdFormatted} to "${newStatus.toUpperCase()}"?`;

            if (confirm(confirmMsg)) {
                fetch(`/management/orders/${orderId}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status: newStatus })
                })
                .then(res => res.json())
                .then(data => {
                    if(data.success) {
                        selectElement.className = `status-dropdown status-${newStatus}`;
                        selectElement.dataset.previous = newStatus;
                        
                        const badge = document.getElementById('headerStatusBadge');
                        badge.className = `detail-status-badge badge-${newStatus}`;
                        badge.innerHTML = `<i class="fa-solid fa-circle status-dot"></i> ${newStatus}`;

                        alert("Status updated successfully!"); 
                    } else {
                        alert("Error updating status.");
                        selectElement.value = previousStatus;
                    }
                })
                .catch(err => {
                    console.error("Error updating order status:", err);
                    selectElement.value = previousStatus;
                });
            } else {
                selectElement.value = previousStatus;
            }
        }
    </script>
</body>
</html>