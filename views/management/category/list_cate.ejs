<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - C-BOOK</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/style-manage.css">
</head>

<body>
    <div class="main-layout">
        <%- include('../../partials/sidebar.ejs') %>

            <main class="content-area">
                <div class="content-header">
                    <div>
                        <h1>Category Management</h1>
                        <p class="subtitle">Organize and manage your library book collections.</p>
                    </div>
                    <a href="/management/category/create" class="btn-primary-add">
                        <i class="fa-solid fa-plus"></i> Add Category
                    </a>
                </div>

                <div class="toolbar-container">
                    <div class="toolbar-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="searchInput" placeholder="Search Category name..."
                            value="<%= searchQuery %>">
                    </div>

                    <div class="toolbar-stats">
                        <div class="mini-stat">
                            <span class="mini-stat-label">Total Categories</span>
                            <div class="mini-stat-value">
                                <%= stats.totalCategories %>
                            </div>
                        </div>
                        
                        <div class="stat-divider"></div>
                        
                        <div class="mini-stat">
                            <span class="mini-stat-label">Total Books</span>
                            <div class="mini-stat-value">
                                <%= stats.totalBooks %>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="data-card">
                    <div class="data-header">
                    </div>

                    <table class="category-table">
                        <thead>
                            <tr>
                                <th style="width: 45%;">CATEGORY NAME</th>
                                <th style="width: 30%;">BOOK COUNT</th>
                                <th style="width: 25%; text-align: right;">ACTIONS</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (categories.length===0) { %>
                                <tr>
                                    <td colspan="6" class="none-data">No categories available.
                                        Add a new category!</td>
                                </tr>
                                <% } %>
                                    <% categories.forEach((cat, index)=> {
                                        const colors = ['purple-light', 'orange-light', 'blue-light', 'pink-light',
                                        'teal-light', 'indigo-light', 'yellow-light', 'cyan-light',
                                        'sky-light', 'fuchsia-light', 'amber-light', 'slate-light'];
                                        const colorClass = colors[index % colors.length];
                                        %>
                                        <tr>
                                            <td>
                                                <div class="cat-name-cell">
                                                    <span class="cat-icon-box <%=colorClass%>">
                                                        <i class="fa-solid fa-book"></i>
                                                    </span>
                                                    <span class="cat-name-text">
                                                        <a href="/management/books?category=<%= cat.category_id %>"
                                                            class="category-link">
                                                            <%= cat.category_name %>
                                                        </a>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge-pill <%= colorClass %>">
                                                    <%= cat.book_count || 0 %> Books
                                                </span>
                                            </td>
                                            <td class="text-right">
                                                <div class="action-group">
                                                    <a href="/management/category/edit/<%= cat.category_id %>"
                                                        class="action-btn-edit">
                                                        <i class="fa-solid fa-pen"></i>
                                                    </a>
                                                    <button onclick="confirmDelete('<%= cat.category_id %>')"
                                                        class="action-btn-delete">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                        </tbody>
                    </table>

                    <div class="data-footer">
                        <div class="showing-text">
                            Showing <%= (currentPage - 1) * limit + 1 %> to <%= Math.min(currentPage * limit,
                                    totalItems) %> of <%= totalItems.toLocaleString() %> entries
                        </div>

                        <div class="pagination">
                            <a href="<%= currentPage > 1 ? '?page=' + (currentPage - 1) + '&search=' + searchQuery : '#' %>"
                                class="page-nav <%= currentPage === 1 ? 'disabled' : '' %>">
                                <i class="fa-solid fa-chevron-left"></i>
                            </a>

                            <% for (let i=1; i <=totalPages; i++) { if (i===1 || i===totalPages || (i>= currentPage - 1
                                && i <= currentPage + 1)) { %>
                                    <a href="?page=<%= i %>&search=<%= searchQuery %>"
                                        class="page-num <%= currentPage === i ? 'active' : '' %>">
                                        <%= i %>
                                    </a>
                                    <% } else if (i===currentPage - 2 || i===currentPage + 2) { %>
                                        <span class="page-dots">...</span>
                                        <% } } %>

                                            <a href="<%= currentPage < totalPages ? '?page=' + (currentPage + 1) + '&search=' + searchQuery : '#' %>"
                                                class="page-nav <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                <i class="fa-solid fa-chevron-right"></i>
                                            </a>
                        </div>
                    </div>
                    
            </main>
    </div>

</body>

</html>

<script>
    let searchTimer;
    let currentAbortController = null;
    const searchInput = document.getElementById('searchInput');

    if (searchInput) {
        searchInput.addEventListener('input', function () {
            clearTimeout(searchTimer);
            const query = this.value;

            if (currentAbortController) currentAbortController.abort();
            currentAbortController = new AbortController();
            const signal = currentAbortController.signal;

            searchTimer = setTimeout(() => {
                
                fetch(`/management/categories?search=${encodeURIComponent(query)}`, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    signal: signal
                })
                    .then(res => res.json())
                    .then(data => {
                        updateTableBody(data.categories || []);
                        updateFooterText(data);
                        updatePagination(data.currentPage, data.totalPages, query);
                    })
                    .catch(err => {
                        if (err.name !== 'AbortError') console.error('Search error:', err);
                    });
            }, 300);
        });
    }

    function updateTableBody(categories) {
        const tbody = document.querySelector('.category-table tbody');
        if (!tbody) return;

        tbody.innerHTML = '';

        if (categories.length === 0) {
            tbody.innerHTML = '<tr><td colspan="3" style="text-align:center; padding: 20px;">No categories found</td></tr>';
            return;
        }

        categories.forEach((cat, index) => {
            const colors = ['purple-light', 'orange-light', 'blue-light', 'pink-light',
                'teal-light', 'indigo-light', 'yellow-light', 'cyan-light',
                'sky-light', 'fuchsia-light', 'amber-light', 'slate-light'];
            const colorClass = colors[index % colors.length];

            const row = `
                <tr>
                    <td>
                        <div class="cat-name-cell">
                            <span class="cat-icon-box ${colorClass}">
                                <i class="fa-solid fa-book"></i>
                            </span>
                            <span class="cat-name-text">
                                <a href="/management/books?category=${cat.category_id}" class="category-link">
                                    ${cat.category_name}
                                </a>
                            </span>
                        </div>
                    </td>
                    <td>
                        <span class="badge-pill ${colorClass}">
                            ${cat.book_count || 0} Books
                        </span>
                    </td>
                    <td class="text-right">
                        <div class="action-group">
                            <a href="/management/category/edit/${cat.category_id}" class="action-btn-edit">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <button onclick="confirmDelete('${cat.category_id}')" class="action-btn-delete">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>`;
            tbody.insertAdjacentHTML('beforeend', row);
        });
    }

    function updateFooterText(data) {
        const showingText = document.querySelector('.showing-text');
        if (showingText) {
            const start = data.totalItems === 0 ? 0 : (data.currentPage - 1) * data.limit + 1;
            const end = Math.min(data.currentPage * data.limit, data.totalItems);
            showingText.innerHTML = `Showing ${start} to ${end} of ${data.totalItems.toLocaleString()} entries`;
        }
    }
    function updatePagination(currentPage, totalPages, query) {
        const paginationContainer = document.querySelector('.pagination');
        if (!paginationContainer) return;
        if (totalPages <= 1) { paginationContainer.innerHTML = ''; return; }

        const getUrl = (p) => `?page=${p}&search=${encodeURIComponent(query)}`;
        let html = `<a href="${currentPage > 1 ? getUrl(currentPage - 1) : '#'}" class="page-nav ${currentPage === 1 ? 'disabled' : ''}"><i class="fa-solid fa-chevron-left"></i></a>`;

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
                html += `<a href="${getUrl(i)}" class="page-num ${currentPage === i ? 'active' : ''}">${i}</a>`;
            } else if (i === currentPage - 2 || i === currentPage + 2) {
                html += `<span class="page-dots">...</span>`;
            }
        }
        
        html += `<a href="${currentPage < totalPages ? getUrl(currentPage + 1) : '#'}" class="page-nav ${currentPage === totalPages ? 'disabled' : ''}"><i class="fa-solid fa-chevron-right"></i></a>`;
        paginationContainer.innerHTML = html;
    }

    // ฟังก์ชันลบ (ใช้เหมือนเดิม)
    function confirmDelete(categoryId) {
        if (confirm('Do you want to delete this category?')) {
            fetch(`/management/category/delete/${categoryId}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            })
                .then(async response => {
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        const data = await response.json();
                        alert(data.message);
                    }
                })
                .catch(error => console.error('Error:', error));
        }
    }
</script>